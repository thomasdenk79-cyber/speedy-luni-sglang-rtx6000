#!/usr/bin/env bash
# pushguard — mechanisches Gate vor jedem Push auf geschutzte Refs.
#
# Warum hier und nicht auf GitHub: Branch-Schutz und Rulesets sind auf private
# Repos dieses Plans paywalled (API liefert 403 "Upgrade to GitHub Pro"). Die
# Server-Seite ist damit keine Durchsetzungsflaeche. Dieses Gate haengt deshalb
# im Repo und behandelt den Push als Produktions-Lifecycle-Aktion:
#   - direkte Pushes auf geschutzte Refs brauchen eine ausdrueckliche Freigabe
#     ueber die Umgebung (LUNI_PUSH_GATE=1 + LUNI_PUSH_REASON) und werden
#     protokolliert,
#   - Erzwungene Pushes (non-fast-forward) und Loeschungen von Kern-Ref/Tags sind
#     immer verboten, auch mit Freigabe.
#
# Aufruf durch git pre-push:  pushguard <remote> <remote-url>
# Zeilen auf stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
# Exit: 0 erlaubt / 1 verweigert / 2 Bedienfehler
set -uo pipefail

PROTECTED="${PUSH_PROTECTED_REFS:-refs/heads/main refs/heads/dev}"
LKG_PREFIXES="${PUSH_LKG_PREFIXES:-refs/tags/lkg- refs/tags/dflash2-labor-anker refs/tags/swift-15-}"
TOP="${LUNI_REPO_TOP:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
LOG="${LUNI_PUSH_GATE_LOG:-$TOP/log/push-gate.jsonl}"
REMOTE="${1:-origin}"
ZERO=0000000000000000000000000000000000000000
APPROVED="${LUNI_PUSH_GATE:-0}"
REASON="${LUNI_PUSH_REASON:-}"

is_protected() { case " $PROTECTED " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
is_lkg() { local r; for r in $LKG_PREFIXES; do [[ $1 == "$r"* ]] && return 0; done; return 1; }

audit() { # $1=aktion  $2=ref  $3=remote_sha  $4=grund
  mkdir -p "$(dirname "$LOG")" 2>/dev/null || return 0
  printf '{"ts":"%s","remote":"%s","ref":"%s","remote_sha":"%s","gate":"%s","reason":"%s","aktion":"%s","grund":"%s","operator":"%s"}\n' \
    "$(date -u +%FT%TZ)" "$REMOTE" "$2" "$3" "$APPROVED" "${REASON:-—}" "$1" "$4" "$(id -un)" >> "$LOG" 2>/dev/null || true
}

refuse() {
  # $1=grund  $2=ref  $3=remote_sha
  audit refuse "$2" "$3" "$1"
  echo "pushguard: VERWEIGERT — $1 (ref=$2, remote=$REMOTE)" >&2
  echo "pushguard: geschutzte Refs: $PROTECTED" >&2
  echo "pushguard: Ausnahme darf nur der Betreiber erteilen; Ablauf und Begruendung:" >&2
  echo "pushguard:   LUNI_PUSH_GATE=1 LUNI_PUSH_REASON='Betreiber-Auftrag <zeit>: <zweck>' git push …" >&2
  exit 1
}

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z ${local_ref:-} ]] && continue

  if is_lkg "$remote_ref"; then
    [[ $local_sha == "$ZERO" ]] && refuse "LKG-Anker/Tag darf nicht geloescht werden" "$remote_ref" "$remote_sha"
    is_lkg "$local_ref" || continue
    [[ $remote_sha == "$ZERO" ]] && continue
    git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null \
      || refuse "Rollback-Anker wird zurueckgedreht" "$remote_ref" "$remote_sha"
    continue
  fi

  is_protected "$remote_ref" || continue

  if [[ $local_sha == "$ZERO" ]]; then
    refuse "Kern-Ref wird geloescht" "$remote_ref" "$remote_sha"
  fi
  if [[ $remote_sha != "$ZERO" ]] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    refuse "Erzwungener Push (non-fast-forward) auf Kern-Ref" "$remote_ref" "$remote_sha"
  fi
  if [[ $APPROVED != 1 ]]; then
    refuse "direkter Push auf geschutzte Ref ohne Betreiber-Freigabe" "$remote_ref" "$remote_sha" \
      "keine Freigabe in der Umgebung (LUNI_PUSH_GATE=1 + LUNI_PUSH_REASON)"
  fi
  [[ -z $REASON ]] && refuse 'Freigabe ohne Begruendung' '$remote_ref' '$remote_sha'
  # Zeitstempel-Pflicht (Betreiber-Fund 26.10. 09:34Z: Runner erfand "Auftrag
  # 09:40Z" = Zukunft): Grund braucht echten Betreiber-Zeitstempel
  # (JJJJ-MM-TT, Zeit optional); Zukunft oder fehlerhaft => Verweigerung.
  ST=$(printf '%s' "$REASON" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}[:0-9]*Z?)?' | head -1)
  [[ -z $ST ]] && refuse "Freigabe ohne Zeitstempel (Format: Betreiber-Auftrag JJJJ-MM-TT[Thh:mmZ]: ...)" "$remote_ref" "$remote_sha"
  ST_ECHT=$(echo "$ST" | sed 's/T/ /;s/Z$//;s/[:].*//' )
  ST_TAG=$(echo "$ST_ECHT" | cut -d' ' -f1)
  HEUTE=$(date +%F)
  [[ "$ST_TAG" > "$HEUTE" ]] && refuse "Freigabe-Zeitstempel in der Zukunft ($ST) — Fuerweisung eines echten Betreiber-Auftrags" "$remote_ref" "$remote_sha"
  if [[ "$ST_TAG" == "$HEUTE" ]] && [[ ${#ST_ECHT} -gt 10 ]]; then
    # Base-10 explicitly: hh is zero-padded; bare $((08)) aborts as octal and
    # silently disarms the future-stamp guard (Befund 61, pushguard:85).
    ST_HH=$((10#$(echo "$ST_ECHT" | cut -d' ' -f2 | cut -d: -f1)))
    [[ $ST_HH -gt $((10#$(date +%H) + 1)) ]] && refuse "Freigabe-Zeitstempel in der Zukunft ($ST)" "$remote_ref" "$remote_sha"
  fi

  audit erlaubt "$remote_ref" "$remote_sha" "$REASON"
  echo "pushguard: erlaubt — $remote_ref (Begruendung: $REASON), Protokoll: $LOG"
  blocked=1
done

[[ $blocked == 1 ]] && exit 0
exit 0
