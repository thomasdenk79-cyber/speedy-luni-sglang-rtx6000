# OWNER: point SGLANG_SRC at the candidate arm worktree (pinned SHA, clean tree)
# and rename NAME/--arm to carry it, e.g. exp-sb-b-prunepdl-r1.  Candidate arms on
# rc/qwen38-rc2 (measured, see 01-UPSTREAM-AND-FORK-DIFF.md): perf/hb-prune-pdl
# 7ee989227b, perf/hb-lowrow-kernels 4eb9a38b69, feat/draft-vocab-head-buckets 182f38c4bb.
# Campaign 2026-11-21 (task 2026-11-21-speedy-baseline), arm A = reference.
# Baseline source: rc/qwen38-rc2 @ a090492091c7ed527d7f48faf35e9dec71e0f034 in a
# private worktree, never the mutable production tree (check_arm R4).
# One knob differs from arm B: SGLANG_SRC.  Everything else is the reference
# shape of gpuq-plan/jobs/t1-00-baseline.env, so the arms stay comparable to the
# tier1/tier2/tier3 rows already in results/results.jsonl.
# IMAGE and PROD_CONTAINER name the owner's container qwen38-rc2 (Betreiber-
# Weisung 2026-11-19, rules R9/R10): an arm runs the owner's build, nothing else.
# PORT is left unset on purpose: the queue derives PORT_BASE + crc32(name)%50
# (gpuq_lib.py 1272-1279), which is never the production port 30000 (R6).
NAME=exp-sb-b-cand-r1
SERVER=launcher
LAUNCH_ENV="MODEL=fp4local KV_DTYPE=nvfp4 PROFILE=kv-hicache MAX_TOTAL_TOKENS=1000000 HICACHE_GB=4 STARTUP_FAST=1 RESTART=no HICACHE_ROOT=/srv/llm-cache/qwen38-flashnext/hicache-exp/exp-sb-b-cand-r1 FILE_MAX_SIZE=40G HICACHE_ROOT_MAX=60G EXTRA_ENV='SGLANG_HICACHE_BUFFER_STREAM=1 SGLANG_HICACHE_FILE_BACKEND_READ_WORKERS=16 SGLANG_HICACHE_FILE_BACKEND_ZERO_COPY_READ=1' EXTRA_SGLANG_ARGS='--enable-cache-report'"
SGLANG_SRC=/srv/community-repos/sglang-wt-REPLACE-ME
IMAGE=docker.io/lmsysorg/sglang:nightly-dev-cu13-20261117-25c1c439
PROD_CONTAINER=qwen38-rc2
STEPS="startup custom:/srv/community-repos/speedy-luni-sglang-rtx6000/docs/perf-2026-11-21/bench/bb-campaign.sh:--arm=arm-b-cand:--cap=300:--repeat=1 custom:scripts/session-replay/step.sh:--sessions=8:--prefix-tokens=20000:--shared-tokens=10000:--turns=40:--turn-new-tokens=1000:--max-tokens=1000:--think-min=0:--think-max=1:--ignore-eos:--seed=1 custom:scripts/session-replay/step.sh:--sessions=1:--prefix-tokens=180000:--turns=8:--turn-new-tokens=1000:--max-tokens=1000:--think-min=0:--think-max=1:--ignore-eos:--seed=11"
REPEAT=1
TIMEOUT_S=4200
START_TIMEOUT_S=900
STEP_TIMEOUTS="custom=1800"
NOTES=speedy candidate arm B: exactly one knob differs from arm A (SGLANG_SRC); same pinned BetterBench config and session shape; power cap asserted 300W
